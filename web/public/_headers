# Cloudflare Pages headers.
# SharedArrayBuffer (used by the Pyodide worker for sync WebSerial I/O)
# requires cross-origin isolation, which is gated behind these two
# headers.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Pyodide runs under CSP with 'wasm-unsafe-eval' (WASM compilation, no
  # JS eval). 'unsafe-inline' is required for the inline COI bootstrap in
  # index.html. worker-src allows the Pyodide web worker (blob: for the
  # Vite dev/prod worker URL). Tighten script-src to hashes/nonces later.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Large static assets — cache aggressively. The bundle filename is
# content-addressed via SHA-256, but for now we cache-bust by hashing
# `chirp_pkg.sha256` and appending it as a query string in the app.

/chirp-bundle/*
  Cache-Control: public, max-age=31536000, immutable

/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
